# Generate actual values with: python3 server/tools/init_config.py
# These placeholders are deliberately invalid and must not be used as credentials.
UPLOAD_TOKEN=<generate-locally>
READ_TOKEN=<generate-a-different-token-locally>
# Relative paths are resolved from the server directory.
DATA_PATH=data/snapshot.sqlite3
# Comma-separated exact origins, no paths or trailing slash.
# Use * explicitly only for local/LAN testing; bearer authentication still applies.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
